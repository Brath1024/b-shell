.xshell-import
  .xshell-import-intro
    margin-bottom 12px
    opacity 0.8
  .xshell-import-path
    display flex
    margin-bottom 12px
  .xshell-import-stats
    margin-bottom 8px
    tag
      margin-bottom 4px
  .xshell-import-unsupported
    font-size 12px
    opacity 0.7
    margin-bottom 8px
  .xshell-session-list
    max-height 46vh
    overflow auto
    margin-bottom 12px
    border 1px solid rgba(128, 128, 128, 0.25)
    border-radius 4px
    padding 4px 8px
  .xshell-session-row
    padding 4px 0
    border-bottom 1px solid rgba(128, 128, 128, 0.15)
    &:last-child
      border-bottom none
  .xshell-session-main
    display flex
    align-items center
    flex-wrap wrap
    gap 8px
  .xshell-session-title
    font-weight 500
  .xshell-session-host
    opacity 0.7
    font-size 12px
  .xshell-session-group
    margin-inline-end 0
  .xshell-empty
    div
      font-size 12px
      margin-top 4px
      opacity 0.75
  .xshell-import-footer
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap 8px
    margin-top 8px
  .xshell-import-password
    display flex
    flex-direction column
  .xshell-import-hint
    font-size 12px
    opacity 0.6
    margin-top 2px
