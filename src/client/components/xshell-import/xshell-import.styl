.xshell-import
  .xshell-import-intro
    margin-bottom 12px
    opacity 0.8
  .xshell-dropzone
    display flex
    flex-direction column
    align-items center
    gap 4px
    padding 18px 12px
    margin-bottom 12px
    border 1px dashed rgba(34, 211, 238, 0.45)
    border-radius 6px
    background rgba(34, 211, 238, 0.04)
    text-align center
    transition border-color 0.15s, background 0.15s
  .xshell-dropzone-icon
    font-size 22px
    color #22d3ee
  .xshell-dropzone-title
    font-weight 500
  .xshell-dropzone-hint
    font-size 12px
    opacity 0.65
  &.xshell-import-dragging
    .xshell-dropzone
      border-color #22d3ee
      background rgba(34, 211, 238, 0.12)
  .xshell-import-path
    display flex
    margin-bottom 12px
  .xshell-import-stats
    margin-bottom 8px
    tag
      margin-bottom 4px
  .xshell-import-source
    font-size 12px
    opacity 0.65
    margin-bottom 8px
    word-break break-all
  .xshell-import-unsupported
    font-size 12px
    opacity 0.7
    margin-bottom 8px
  .xshell-session-list
    max-height 46vh
    overflow auto
    margin-bottom 12px
    border 1px solid rgba(128, 128, 128, 0.25)
    border-radius 4px
    padding 4px 8px
  .xshell-session-row
    padding 4px 0
    border-bottom 1px solid rgba(128, 128, 128, 0.15)
    &:last-child
      border-bottom none
  .xshell-session-main
    display flex
    align-items center
    flex-wrap wrap
    gap 8px
  .xshell-session-title
    font-weight 500
  .xshell-session-host
    opacity 0.7
    font-size 12px
  .xshell-session-group
    margin-inline-end 0
  .xshell-empty
    div
      font-size 12px
      margin-top 4px
      opacity 0.75
  .xshell-import-footer
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap 8px
    margin-top 8px
  .xshell-import-password
    display flex
    flex-direction column
  .xshell-import-hint
    font-size 12px
    opacity 0.6
    margin-top 2px
