{
  "appId": "com.brath.bshell",
  "directories": {
    "app": "work/app",
    "output": "dist",
    "buildResources": "src/build/resources"
  },
  "electronLanguages": [
    "en-US"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/node-pty/build/Release/**"
  ],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "win": {
    "target": [
      "tar.gz",
      "appx",
      "nsis"
    ],
    "icon": "src/build/resources/icons-win.ico"
  },
  "protocols": [
    {
      "name": "SSH Protocol",
      "schemes": [
        "ssh"
      ]
    },
    {
      "name": "Telnet Protocol",
      "schemes": [
        "telnet"
      ]
    },
    {
      "name": "RDP Protocol",
      "schemes": [
        "rdp"
      ]
    },
    {
      "name": "VNC Protocol",
      "schemes": [
        "vnc"
      ]
    },
    {
      "name": "Serial Protocol",
      "schemes": [
        "serial"
      ]
    },
    {
      "name": "Spice Protocol",
      "schemes": [
        "spice"
      ]
    },
    {
      "name": "B-Shell Protocol",
      "schemes": [
        "b-shell"
      ]
    }
  ],
  "fileAssociations": [
    {
      "ext": "vv",
      "name": "Virt Viewer connection file",
      "description": "SPICE console connection file (virt-viewer / remote-viewer)",
      "mimeType": "application/x-virt-viewer",
      "role": "Viewer"
    }
  ],
  "appx": {
    "applicationId": "bshell",
    "identityName": "Brath.b-shell",
    "publisher": "CN=9F481654-170A-434C-8259-984D2EB1FD7F",
    "publisherDisplayName": "Brath"
  },
  "nsis": {
    "oneClick": false,
    "artifactName": "${productName}-${version}-${os}-${arch}-installer.${ext}",
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": "dmg",
    "icon": "src/build/resources/icons.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "./src/build/entitlements.plist",
    "entitlementsInherit": "./src/build/entitlements.plist",
    "notarize": false
  },
  "dmg": {
    "contents": [
      {
        "x": 110,
        "y": 190
      },
      {
        "x": 440,
        "y": 190,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "linux": {
    "category": "Development;System;TerminalEmulator",
    "icon": "src/build/resources/build-res/linux",
    "target": [
      "rpm",
      "deb",
      "AppImage",
      "tar.gz",
      "snap"
    ],
    "desktop": {
      "entry": {
        "StartupWMClass": "b-shell"
      }
    }
  },
  "snap": {
    "confinement": "classic"
  },
  "deb": {
    "afterInstall": "src/build/bin/linux-deb-after-build.sh",
    "depends": [
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libgbm1",
      "libasound2t64 | libasound2"
    ]
  }
}
